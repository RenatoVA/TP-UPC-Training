{"judgments": [{"dataset_id": "case::jp_00051_e0005::q06", "chunk_id": "chunk_tipo02_cp_art_122-b_01", "relevance": "no", "rationale": "Regula lesiones leves y no trata la ebriedad como agravante ni excusa."}, {"dataset_id": "case::jp_00051_e0005::q06", "chunk_id": "chunk_tipo02_cp_art_121-b_01", "relevance": "si", "rationale": "El numeral 8 agrava la pena de lesiones graves cuando el agente actúa en estado de ebriedad."}, {"dataset_id": "case::jp_00051_e0005::q06", "chunk_id": "chunk_tipo01_ley30364_art_31_01", "relevance": "no", "rationale": "Trata del tratamiento penitenciario, no de la ebriedad en la agresión."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q01", "chunk_id": "chunk_tipo01_ley30364_art_121-b_01", "relevance": "si", "rationale": "Fija pena de 6 a 12 años para lesiones graves a mujer o cónyuge."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo03_cpp_art_517_01", "relevance": "no", "rationale": "Extradición, no relacionado."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo04_jp_00013_e0009_01", "relevance": "parcial", "rationale": "Caso de lesiones graves por violencia familiar con art. 121-B, pero trata sobre impugnación."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo01_ley30364_art_122_01", "relevance": "parcial", "rationale": "Lesiones leves con pena mayor si la víctima es mujer, pero no son lesiones graves."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo03_cpp_art_427_01", "relevance": "no", "rationale": "Casación, no relacionado."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo03_cpp_art_97_01", "relevance": "no", "rationale": "Apoderado común de agraviados, no relacionado."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo03_cpp_art_457_01", "relevance": "no", "rationale": "Proceso de seguridad, no relacionado."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo02_cp_art_121-b_01", "relevance": "si", "rationale": "Establece pena agravada de 6 a 12 años para lesiones graves a la mujer por su condición de tal."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo03_cpp_art_532_01", "relevance": "no", "rationale": "Asistencia judicial internacional, no relacionado."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo04_jp_00196_e0016_01", "relevance": "no", "rationale": "Acuerdo reparatorio en lesiones leves, no responde sobre mayor castigo."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo02_cp_art_303-b_01", "relevance": "no", "rationale": "Tráfico de migrantes, otro delito."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo01_ley30364_art_121-b_01", "relevance": "si", "rationale": "Establece la forma agravada de lesiones graves por ser mujer, con pena de 6 a 12 años."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo03_cpp_art_314_01", "relevance": "no", "rationale": "Pensión anticipada de alimentos, no responde sobre la pena."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q02", "chunk_id": "chunk_tipo01_ley30364_art_8_01", "relevance": "no", "rationale": "Define tipos de violencia, sin comparar penas."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q03", "chunk_id": "chunk_tipo01_ley30364_art_121-b_01", "relevance": "si", "rationale": "El numeral 3 agrava la pena cuando la víctima depende o está subordinada al agresor."}, {"dataset_id": "train::chunk_tipo01_ley30364_art_121-b_01::q04", "chunk_id": "chunk_tipo01_ley30364_art_121-b_01", "relevance": "si", "rationale": "Si la víctima muere y el agente pudo preverlo, la pena es de 12 a 15 años."}]}